{
  "name": "mathchois",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @mathchois/server",
    "dev:client": "npm run dev -w @mathchois/client",
    "build": "npm run build -w @mathchois/shared && npm run build -w @mathchois/client && npm run build -w @mathchois/server",
    "start": "npm run start -w @mathchois/server",
    "lint": "npm run lint -w @mathchois/client",
    "ai:pull": "tsx scripts/ai-hub/pull.ts",
    "ai:push": "tsx scripts/ai-hub/media-push.ts",
    "ai:prepare": "tsx scripts/ai-hub/media-prepare.ts",
    "ai:motion:import": "tsx scripts/ai-hub/motion-import.ts",
    "ai:slide:import": "tsx scripts/ai-hub/slide-import.ts",
    "ai:brand:import": "tsx scripts/ai-hub/brand-import.ts",
    "ai:oppadu": "tsx scripts/ai-hub/oppadu/main.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "0.27.3",
    "tsx": "^4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
