nul
image.png
*.tsbuildinfo

# Reference docs kept locally (curriculum PDFs etc.)
*.pdf

# Superpowers (brainstorm visual companion / local plan drafts / review scratch)
.superpowers/
.plans/
review.md

# Unused legacy code
legacy_rails/

# Local storage (dev file uploads)
local-storage/

# Drizzle (drizzle-kit generated output; schema.ts is source of truth, applied via db:push + startupMigrate)
drizzle/

# Python bytecode (e.g. .claude/skills/*/scripts)
__pycache__/
*.pyc

